{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cir2c: Build (Debug)",
      "type": "shell",
      "command": "cmake -S ${workspaceFolder} -B ${workspaceFolder}/build -DCMAKE_BUILD_TYPE=Debug && cmake --build ${workspaceFolder}/build -j$(nproc)",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "cir2c: Run integration tests",
      "type": "shell",
      "command": "bash ${workspaceFolder}/test/run_tests.sh",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
