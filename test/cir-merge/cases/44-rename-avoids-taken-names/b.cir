!s32i = !cir.int<s, 32>
module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.global "private" internal @x = #cir.int<2> : !s32i
  cir.global external @x.tu1 = #cir.int<3> : !s32i
  cir.func @fb() -> !s32i {
    %0 = cir.get_global @x : !cir.ptr<!s32i>
    %1 = cir.load %0 : !cir.ptr<!s32i>, !s32i
    cir.return %1 : !s32i
  }
}
