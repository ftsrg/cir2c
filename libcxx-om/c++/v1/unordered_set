// Operational Model: <unordered_set>
// Simplified C++ header for std::unordered_set

#ifndef _LIBCXX_OM_UNORDERED_SET
#define _LIBCXX_OM_UNORDERED_SET

#include <stddef.h>

namespace std {

// unordered_set - simplified
template<typename Key, typename Hash = hash<Key>, typename KeyEqual = equal_to<Key>, typename Allocator = allocator<Key>>
class unordered_set {
public:
    typedef Key key_type;
    typedef Key value_type;
    typedef Hash hash_function;
    typedef KeyEqual key_equal;
    typedef Allocator allocator_type;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;

    struct iterator {
        const value_type* ptr;
        iterator(const value_type* p = nullptr) : ptr(p) {}
        const value_type& operator*() const { return *ptr; }
        const value_type* operator->() const { return ptr; }
        iterator& operator++() { ptr++; return *this; }
        bool operator==(const iterator& other) const { return ptr == other.ptr; }
        bool operator!=(const iterator& other) const { return ptr != other.ptr; }
    };

    typedef iterator const_iterator;

    static constexpr size_t MAX_SIZE = 64;

    unordered_set() : data_(nullptr), size_(0) {}

    unordered_set(const unordered_set& other) : data_(nullptr), size_(0) {
        for (size_type i = 0; i < other.size_; i++) {
            insert(other.data_[i]);
        }
    }

    unordered_set(unordered_set&& other) noexcept : data_(other.data_), size_(other.size_) {
        other.data_ = nullptr;
        other.size_ = 0;
    }

    ~unordered_set() {
        if (data_) delete[] data_;
    }

    unordered_set& operator=(const unordered_set& other) {
        if (this != &other) {
            clear();
            for (size_type i = 0; i < other.size_; i++) {
                insert(other.data_[i]);
            }
        }
        return *this;
    }

    unordered_set& operator=(unordered_set&& other) noexcept {
        if (this != &other) {
            if (data_) delete[] data_;
            data_ = other.data_;
            size_ = other.size_;
            other.data_ = nullptr;
            other.size_ = 0;
        }
        return *this;
    }

    iterator begin() noexcept { return iterator(data_); }
    iterator end() noexcept { return iterator(data_ + size_); }
    const_iterator begin() const noexcept { return const_iterator(data_); }
    const_iterator end() const noexcept { return const_iterator(data_ + size_); }

    size_type size() const noexcept { return size_; }
    size_type max_size() const noexcept { return MAX_SIZE; }
    bool empty() const noexcept { return size_ == 0; }

    pair<iterator, bool> insert(const value_type& value) {
        for (size_type i = 0; i < size_; i++) {
            if (data_[i] == value) return pair<iterator, bool>(iterator(data_ + i), false);
        }
        if (size_ < MAX_SIZE) {
            value_type* new_data = new value_type[size_ + 1];
            if (data_) {
                for (size_type i = 0; i < size_; i++) new_data[i] = data_[i];
                delete[] data_;
            }
            new_data[size_] = value;
            data_ = new_data;
            size_++;
            return pair<iterator, bool>(iterator(data_ + size_ - 1), true);
        }
        __VERIFIER_error();
        return pair<iterator, bool>(iterator(data_), false);
    }

    void insert(initializer_list<value_type> il) {
        for (auto it = il.begin(); it != il.end(); ++it) {
            insert(*it);
        }
    }

    iterator erase(iterator pos) {
        size_type idx = pos.ptr - data_;
        for (size_type i = idx; i < size_ - 1; i++) {
            data_[i] = data_[i + 1];
        }
        size_--;
        return iterator(data_ + idx);
    }

    size_type erase(const value_type& value) {
        for (size_type i = 0; i < size_; i++) {
            if (data_[i] == value) {
                for (size_type j = i; j < size_ - 1; j++) {
                    data_[j] = data_[j + 1];
                }
                size_--;
                return 1;
            }
        }
        return 0;
    }

    void clear() noexcept {
        if (data_) delete[] data_;
        data_ = nullptr;
        size_ = 0;
    }

    void swap(unordered_set& other) noexcept {
        value_type* tmp_data = data_;
        size_type tmp_size = size_;
        data_ = other.data_;
        size_ = other.size_;
        other.data_ = tmp_data;
        other.size_ = tmp_size;
    }

    size_type count(const Key& key) const {
        for (size_type i = 0; i < size_; i++) {
            if (data_[i] == key) return 1;
        }
        return 0;
    }

    iterator find(const Key& key) {
        for (size_type i = 0; i < size_; i++) {
            if (data_[i] == key) return iterator(data_ + i);
        }
        return end();
    }

    const_iterator find(const Key& key) const {
        for (size_type i = 0; i < size_; i++) {
            if (data_[i] == key) return const_iterator(data_ + i);
        }
        return end();
    }

    hash_function hash_function() const { return hash_function(); }
    key_equal key_eq() const { return key_equal(); }
    allocator_type get_allocator() const { return allocator_type(); }

    size_type bucket_count() const noexcept { return size_; }
    size_type max_bucket_count() const noexcept { return MAX_SIZE; }

    bool operator==(const unordered_set& other) const {
        if (size_ != other.size_) return false;
        for (size_type i = 0; i < size_; i++) {
            bool found = false;
            for (size_type j = 0; j < other.size_; j++) {
                if (data_[i] == other.data_[j]) { found = true; break; }
            }
            if (!found) return false;
        }
        return true;
    }

    bool operator!=(const unordered_set& other) const { return !(*this == other); }

private:
    value_type* data_;
    size_type size_;
};

template<typename Key, typename Hash, typename KeyEqual, typename Allocator>
void swap(unordered_set<Key, Hash, KeyEqual, Allocator>& x, unordered_set<Key, Hash, KeyEqual, Allocator>& y) noexcept {
    x.swap(y);
}

} // namespace std

#endif // _LIBCXX_OM_UNORDERED_SET
