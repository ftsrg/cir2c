#ifndef _LIBCPP_UNORDERED_SET
#define _LIBCPP_UNORDERED_SET

#include <__om/assoc.h>

_LIBCPP_BEGIN_NAMESPACE_STD

template <class _Key, class _Hash = hash<_Key>, class _Pred = equal_to<_Key>, class _Allocator = allocator<_Key> >
class unordered_set : public __om_assoc<_Key, _Key, __om_key_of_self, _Pred, false, false> {
  using _Base = __om_assoc<_Key, _Key, __om_key_of_self, _Pred, false, false>;

public:
  using hasher         = _Hash;
  using key_equal      = _Pred;
  using allocator_type = _Allocator;
  unordered_set() {}
  explicit unordered_set(size_t) {}
  unordered_set(initializer_list<_Key> __il) { this->insert(__il); }
  template <class _It, __enable_if_t<!is_integral<_It>::value, int> = 0>
  unordered_set(_It __f, _It __l) { this->insert(__f, __l); }
  _OM_ASSOC_MEMBERS(unordered_set)
  void reserve(size_t) {}
  void rehash(size_t) {}
};

template <class _Key, class _Hash = hash<_Key>, class _Pred = equal_to<_Key>, class _Allocator = allocator<_Key> >
class unordered_multiset : public __om_assoc<_Key, _Key, __om_key_of_self, _Pred, false, true> {
  using _Base = __om_assoc<_Key, _Key, __om_key_of_self, _Pred, false, true>;

public:
  using hasher         = _Hash;
  using key_equal      = _Pred;
  using allocator_type = _Allocator;
  unordered_multiset() {}
  explicit unordered_multiset(size_t) {}
  _OM_ASSOC_MEMBERS(unordered_multiset)
};

_LIBCPP_END_NAMESPACE_STD

#endif
