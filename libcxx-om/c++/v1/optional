// Operational Model: <optional>
// Simplified C++ header for std::optional

#ifndef _LIBCXX_OM_OPTIONAL
#define _LIBCXX_OM_OPTIONAL

namespace std {

template<typename T>
class optional {
public:
    optional() noexcept : has_value_(false) {}

    optional(const T& value) : value_(value), has_value_(true) {}

    optional(T&& value) : value_(std::move(value)), has_value_(true) {}

    optional(const optional& other) : value_(other.value_), has_value_(other.has_value_) {}

    optional(optional&& other) noexcept : value_(std::move(other.value_)), has_value_(other.has_value_) {
        other.has_value_ = false;
    }

    optional& operator=(const optional& other) {
        value_ = other.value_;
        has_value_ = other.has_value_;
        return *this;
    }

    optional& operator=(optional&& other) noexcept {
        value_ = std::move(other.value_);
        has_value_ = other.has_value_;
        other.has_value_ = false;
        return *this;
    }

    T& operator*() noexcept { return value_; }
    const T& operator*() const noexcept { return value_; }

    T* operator->() noexcept { return &value_; }
    const T* operator->() const noexcept { return &value_; }

    T& value() {
        if (!has_value_) __VERIFIER_error();
        return value_;
    }

    const T& value() const {
        if (!has_value_) __VERIFIER_error();
        return value_;
    }

    T value_or(T default_value) const {
        return has_value_ ? value_ : default_value;
    }

    explicit operator bool() const noexcept { return has_value_; }
    bool has_value() const noexcept { return has_value_; }

    void reset() noexcept { has_value_ = false; }

    void swap(optional& other) noexcept {
        bool tmp = has_value_;
        has_value_ = other.has_value_;
        other.has_value_ = tmp;
        std::swap(value_, other.value_);
    }

private:
    T value_;
    bool has_value_;
};

template<typename T>
void swap(optional<T>& x, optional<T>& y) noexcept {
    x.swap(y);
}

template<typename T>
bool operator==(const optional<T>& x, const optional<T>& y) {
    if (!x.has_value() && !y.has_value()) return true;
    if (x.has_value() != y.has_value()) return false;
    return *x == *y;
}

template<typename T>
bool operator!=(const optional<T>& x, const optional<T>& y) {
    return !(x == y);
}

template<typename T>
bool operator==(const optional<T>& x, std::nullptr_t) {
    return !x.has_value();
}

template<typename T>
bool operator!=(const optional<T>& x, std::nullptr_t) {
    return x.has_value();
}

// in_place_t
struct in_place_t {};
constexpr in_place_t in_place{};

// nullopt_t
struct nullopt_t {};
constexpr nullopt_t nullopt{};

} // namespace std

#endif // _LIBCXX_OM_OPTIONAL
