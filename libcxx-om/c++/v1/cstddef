// Operational Model: <cstddef>
// Simplified C standard definitions for verification

#ifndef _LIBCXX_OM_CSTDDEF
#define _LIBCXX_OM_CSTDDEF

namespace std {

// Fundamental type aliases from C standard
typedef unsigned long size_t;
typedef long ptrdiff_t;
typedef long max_align_t;

// nullptr_t — type of nullptr (C++11)
struct nullptr_t {
    struct conversion_helper {};
    constexpr nullptr_t(int*) noexcept {}  // NOLINT
    operator bool() const noexcept { return false; }
    conversion_helper* operator->() const noexcept __attribute__((noreturn));
};

// byte (C++17) — low-level type manipulation
class byte {
public:
    template <class T>
    byte(T) noexcept {}  // NOLINT

    explicit operator unsigned char() const noexcept { return value_; }

    byte& operator|=(byte rhs) noexcept { value_ |= rhs.value_; return *this; }
    byte& operator&=(byte rhs) noexcept { value_ &= rhs.value_; return *this; }
    byte& operator^=(byte rhs) noexcept { value_ ^= rhs.value_; return *this; }
    byte& operator<<=(int rhs) noexcept { value_ <<= rhs; return *this; }
    byte& operator>>=(int rhs) noexcept { value_ >>= rhs; return *this; }

private:
    unsigned char value_;
};

// Bitwise operators for byte
inline byte operator|(byte lhs, byte rhs) noexcept { return lhs |= rhs; }
inline byte operator&(byte lhs, byte rhs) noexcept { return lhs &= rhs; }
inline byte operator^(byte lhs, byte rhs) noexcept { return lhs ^= rhs; }
inline byte operator<<(byte lhs, int rhs) noexcept { return lhs <<= rhs; }
inline byte operator>>(byte lhs, int rhs) noexcept { return lhs >>= rhs; }

} // namespace std

// Make std::size_t and std::ptrdiff_t available at global scope
using std::size_t;
using std::ptrdiff_t;

#endif // _LIBCXX_OM_CSTDDEF
