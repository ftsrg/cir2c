// rank
template<typename T> struct rank { static constexpr size_t value = 0; };
template<typename T, size_t N> struct rank<T[N]> { static constexpr size_t value = 1 + rank<T>::value; };

// extent
template<typename T, size_t I = 0> struct extent { static constexpr size_t value = 0; };
template<typename T, size_t N> struct extent<T[N], 0> { static constexpr size_t value = N; };
template<typename T, size_t N, size_t I> struct extent<T[N], I> { static constexpr size_t value = extent<T, I - 1>::value; };

// remove_all_extents
template<typename T> struct remove_all_extents { typedef T type; };
template<typename T, size_t N> struct remove_all_extents<T[N]> { typedef typename remove_all_extents<T>::type type; };

// max_align_t
struct max_align_t { double __data; };

// aligned_storage
template<size_t Len, size_t Align = alignof(max_align_t)>
struct aligned_storage {
    struct type { alignas(Align) unsigned char __data[Len]; };
};

// swap for arrays
template<typename T, size_t N>
inline void swap(T (&a)[N], T (&b)[N]) {
    for (size_t i = 0; i < N; i++) swap(a[i], b[i]);
}

