// integral_constant
template<class T, T v>
struct integral_constant {
    static constexpr T value = v;
    typedef T value_type;
    typedef integral_constant<T, v> type;
    constexpr operator value_type() const noexcept { return value; }
    constexpr value_type operator()() const noexcept { return value; }
};
typedef integral_constant<bool, true> true_type;
typedef integral_constant<bool, false> false_type;

// declval
template<typename T> T&& declval() noexcept;

// void_t
template<typename...> using void_t = void;

// decay
template<typename T>
struct decay {
    typedef typename remove_cv<typename remove_reference<T>::type>::type type;
};

// common_type
template<typename... T> struct common_type { typedef int type; };
template<typename T> struct common_type<T> { typedef T type; };
template<typename T, typename U>
struct common_type<T, U> {
    typedef decltype(true ? declval<T>() : declval<U>()) type;
};

// reference_wrapper
template<typename T>
struct reference_wrapper {
    T* ptr;
    reference_wrapper(T& val) : ptr(&val) {}
    operator T&() const { return *ptr; }
    T& get() const { return *ptr; }
    T& operator()() const { return (*ptr)(); }
};

// is_reference_wrapper
template<typename T> struct is_reference_wrapper { static constexpr bool value = false; };
template<typename T> struct is_reference_wrapper<reference_wrapper<T>> { static constexpr bool value = true; };

