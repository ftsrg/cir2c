// Operational Model: <map>
// Minimal std::map for verification

#ifndef _LIBCXX_OM_MAP
#define _LIBCXX_OM_MAP

#include <utility>

namespace std {

template<typename T>
struct less {
    bool operator()(const T& a, const T& b) const { return a < b; }
};

template<typename Key, typename T, typename Compare = less<Key>>
class map {
public:
    typedef Key key_type;
    typedef T mapped_type;
    typedef pair<const Key, T> value_type;
    typedef Compare key_compare;
    typedef unsigned long size_type;
    typedef Key* iterator;
    typedef const Key* const_iterator;

    static constexpr size_type MAX_SIZE = 64;

    map() : size_(0) {}

    map(const map& other) : size_(other.size_) {
        for (size_type i = 0; i < size_; i++) {
            keys_[i] = other.keys_[i];
            values_[i] = other.values_[i];
        }
    }

    map(map&& other) : size_(other.size_) {
        for (size_type i = 0; i < size_; i++) {
            keys_[i] = other.keys_[i];
            values_[i] = other.values_[i];
        }
        other.size_ = 0;
    }

    map& operator=(const map& other) {
        if (this != &other) {
            size_ = other.size_;
            for (size_type i = 0; i < size_; i++) {
                keys_[i] = other.keys_[i];
                values_[i] = other.values_[i];
            }
        }
        return *this;
    }

    // Iterators
    iterator begin() { return keys_; }
    const_iterator begin() const { return keys_; }
    iterator end() { return keys_ + size_; }
    const_iterator end() const { return keys_ + size_; }
    const_iterator cbegin() const { return keys_; }
    const_iterator cend() const { return keys_ + size_; }

    // Capacity
    size_type size() const { return size_; }
    bool empty() const { return size_ == 0; }

    // Element access
    T& operator[](const Key& key) {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return values_[i];
        }
        keys_[size_] = key;
        values_[size_] = T();
        size_++;
        return values_[size_ - 1];
    }

    T& at(const Key& key) {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return values_[i];
        }
        __builtin_unreachable();
    }

    const T& at(const Key& key) const {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return values_[i];
        }
        __builtin_unreachable();
    }

    // Modifiers
    void clear() { size_ = 0; }

    pair<iterator, bool> insert(const value_type& value) {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == value.first) return pair<iterator, bool>(keys_ + i, false);
        }
        keys_[size_] = value.first;
        values_[size_] = value.second;
        return pair<iterator, bool>(keys_ + size_++, true);
    }

    iterator find(const Key& key) {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return keys_ + i;
        }
        return keys_ + size_;
    }

    const_iterator find(const Key& key) const {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return keys_ + i;
        }
        return keys_ + size_;
    }

    size_type count(const Key& key) const {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return 1;
        }
        return 0;
    }

    size_type erase(const Key& key) {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) {
                for (size_type j = i; j < size_ - 1; j++) {
                    keys_[j] = keys_[j + 1];
                    values_[j] = values_[j + 1];
                }
                size_--;
                return 1;
            }
        }
        return 0;
    }

    void swap(map& other) {
        size_type ts = size_;
        for (size_type i = 0; i < MAX_SIZE; i++) {
            Key tk = keys_[i]; T tv = values_[i];
            keys_[i] = other.keys_[i]; values_[i] = other.values_[i];
            other.keys_[i] = tk; other.values_[i] = tv;
        }
        size_ = other.size_; other.size_ = ts;
    }

    // Comparison
    bool operator==(const map& other) const {
        if (size_ != other.size_) return false;
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] != other.keys_[i] || values_[i] != other.values_[i]) return false;
        }
        return true;
    }
    bool operator!=(const map& other) const { return !(*this == other); }

private:
    Key keys_[MAX_SIZE];
    T values_[MAX_SIZE];
    size_type size_;
};

template<typename Key, typename T, typename Compare>
void swap(map<Key, T, Compare>& x, map<Key, T, Compare>& y) { x.swap(y); }

} // namespace std

#endif // _LIBCXX_OM_MAP
