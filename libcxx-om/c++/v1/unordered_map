#ifndef _LIBCPP_UNORDERED_MAP
#define _LIBCPP_UNORDERED_MAP

#include <__om/assoc.h>

_LIBCPP_BEGIN_NAMESPACE_STD

template <class _Key, class _Tp, class _Hash = hash<_Key>, class _Pred = equal_to<_Key>, class _Allocator = allocator<pair<const _Key, _Tp> > >
class unordered_map : public __om_map_access<_Key, _Tp, __om_assoc<pair<const _Key, _Tp>, _Key, __om_key_of_pair, _Pred, false, false> > {
  using _Base = __om_map_access<_Key, _Tp, __om_assoc<pair<const _Key, _Tp>, _Key, __om_key_of_pair, _Pred, false, false> >;

public:
  using hasher         = _Hash;
  using key_equal      = _Pred;
  using allocator_type = _Allocator;
  unordered_map() {}
  explicit unordered_map(size_t) {}
  unordered_map(initializer_list<pair<const _Key, _Tp> > __il) { this->insert(__il); }
  template <class _It, __enable_if_t<!is_integral<_It>::value, int> = 0>
  unordered_map(_It __f, _It __l) { this->insert(__f, __l); }
  _OM_ASSOC_MEMBERS(unordered_map)
  void reserve(size_t) {}
  void rehash(size_t) {}
};

template <class _Key, class _Tp, class _Hash = hash<_Key>, class _Pred = equal_to<_Key>, class _Allocator = allocator<pair<const _Key, _Tp> > >
class unordered_multimap : public __om_assoc<pair<const _Key, _Tp>, _Key, __om_key_of_pair, _Pred, false, true> {
  using _Base = __om_assoc<pair<const _Key, _Tp>, _Key, __om_key_of_pair, _Pred, false, true>;

public:
  using hasher         = _Hash;
  using key_equal      = _Pred;
  using mapped_type    = _Tp;
  using allocator_type = _Allocator;
  unordered_multimap() {}
  explicit unordered_multimap(size_t) {}
  _OM_ASSOC_MEMBERS(unordered_multimap)
};

_LIBCPP_END_NAMESPACE_STD

#endif
