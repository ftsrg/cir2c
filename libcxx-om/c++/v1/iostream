// Operational Model: <iostream>
// Minimal I/O for verification — all operations are no-ops

#ifndef _LIBCXX_OM_IOSTREAM
#define _LIBCXX_OM_IOSTREAM

namespace std {

typedef unsigned long streamsize;

// Minimal stream — all operations are no-ops for verification
class ostream {
public:
    ostream& operator<<(int) { return *this; }
    ostream& operator<<(double) { return *this; }
    ostream& operator<<(char) { return *this; }
    ostream& operator<<(const char*) { return *this; }
    ostream& operator<<(const void*) { return *this; }
    ostream& operator<<(bool) { return *this; }
    ostream& operator<<(unsigned int) { return *this; }
    ostream& operator<<(long) { return *this; }
    ostream& operator<<(unsigned long) { return *this; }
    ostream& operator<<(long long) { return *this; }
    ostream& operator<<(unsigned long long) { return *this; }
    ostream& operator<<(long double) { return *this; }
    ostream& operator<<(ostream& (*)(ostream&)) { return *this; }
    ostream& flush() { return *this; }
    ostream& put(char) { return *this; }
    ostream& write(const char*, streamsize) { return *this; }
};

class istream {
public:
    istream& operator>>(int&) { return *this; }
    istream& operator>>(double&) { return *this; }
    istream& operator>>(char&) { return *this; }
    istream& operator>>(bool&) { return *this; }
    istream& getline(char*, streamsize) { return *this; }
    istream& get(char&) { return *this; }
    istream& ignore() { return *this; }
    istream& read(char*, streamsize) { return *this; }
    streamsize gcount() const { return 0; }
    istream& operator>>(istream& (*)(istream&)) { return *this; }
};

// Manipulators — all no-ops
inline ostream& endl(ostream& os) { return os; }
inline ostream& ends(ostream& os) { return os; }
inline ostream& flush(ostream& os) { return os; }
inline istream& ws(istream& is) { return is; }

// Global objects
extern ostream cout;
extern istream cin;
extern ostream cerr;
extern ostream clog;

ostream cout;
istream cin;
ostream cerr;
ostream clog;

} // namespace std

#endif // _LIBCXX_OM_IOSTREAM
