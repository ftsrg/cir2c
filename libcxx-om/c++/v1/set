// Operational Model: <set>
// Minimal std::set for verification

#ifndef _LIBCXX_OM_SET
#define _LIBCXX_OM_SET

#include <utility>

namespace std {

template<typename T>
struct less {
    bool operator()(const T& a, const T& b) const { return a < b; }
};

template<typename Key, typename Compare = less<Key>>
class set {
public:
    typedef Key key_type;
    typedef Key value_type;
    typedef Compare key_compare;
    typedef unsigned long size_type;
    typedef Key* iterator;
    typedef const Key* const_iterator;

    static constexpr size_type MAX_SIZE = 64;

    set() : size_(0) {}

    set(const set& other) : size_(other.size_) {
        for (size_type i = 0; i < size_; i++) keys_[i] = other.keys_[i];
    }

    set(set&& other) : size_(other.size_) {
        for (size_type i = 0; i < size_; i++) keys_[i] = other.keys_[i];
        other.size_ = 0;
    }

    set& operator=(const set& other) {
        if (this != &other) {
            size_ = other.size_;
            for (size_type i = 0; i < size_; i++) keys_[i] = other.keys_[i];
        }
        return *this;
    }

    iterator begin() { return keys_; }
    const_iterator begin() const { return keys_; }
    iterator end() { return keys_ + size_; }
    const_iterator end() const { return keys_ + size_; }
    const_iterator cbegin() const { return keys_; }
    const_iterator cend() const { return keys_ + size_; }

    size_type size() const { return size_; }
    bool empty() const { return size_ == 0; }

    void clear() { size_ = 0; }

    pair<iterator, bool> insert(const Key& key) {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return pair<iterator, bool>(keys_ + i, false);
        }
        keys_[size_] = key;
        return pair<iterator, bool>(keys_ + size_++, true);
    }

    iterator find(const Key& key) {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return keys_ + i;
        }
        return keys_ + size_;
    }

    const_iterator find(const Key& key) const {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return keys_ + i;
        }
        return keys_ + size_;
    }

    size_type count(const Key& key) const {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) return 1;
        }
        return 0;
    }

    size_type erase(const Key& key) {
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] == key) {
                for (size_type j = i; j < size_ - 1; j++) keys_[j] = keys_[j + 1];
                size_--;
                return 1;
            }
        }
        return 0;
    }

    void swap(set& other) {
        size_type ts = size_;
        for (size_type i = 0; i < MAX_SIZE; i++) {
            Key tk = keys_[i]; keys_[i] = other.keys_[i]; other.keys_[i] = tk;
        }
        size_ = other.size_; other.size_ = ts;
    }

    bool operator==(const set& other) const {
        if (size_ != other.size_) return false;
        for (size_type i = 0; i < size_; i++) {
            if (keys_[i] != other.keys_[i]) return false;
        }
        return true;
    }
    bool operator!=(const set& other) const { return !(*this == other); }

private:
    Key keys_[MAX_SIZE];
    size_type size_;
};

template<typename Key, typename Compare>
void swap(set<Key, Compare>& x, set<Key, Compare>& y) { x.swap(y); }

} // namespace std

#endif // _LIBCXX_OM_SET
