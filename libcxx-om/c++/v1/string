template <class _Int>
string __om_int_to_string(_Int __v) {
  char __b[32];
  int __n = 32;
  bool __neg = __v < _Int(0);
  // Through unsigned, as the smallest value of a signed type has no negation.
  unsigned long long __u = __neg ? 0ULL - (unsigned long long)__v : (unsigned long long)__v;
  do {
    __b[--__n] = char('0' + __u % 10);
    __u /= 10;
  } while (__u != 0);
  if (__neg) __b[--__n] = '-';
  return string(__b + __n, size_t(32 - __n));
}
inline string to_string(int __v) { return __om_int_to_string(__v); }
inline string to_string(unsigned __v) { return __om_int_to_string(__v); }
inline string to_string(long __v) { return __om_int_to_string(__v); }
inline string to_string(unsigned long __v) { return __om_int_to_string(__v); }
inline string to_string(long long __v) { return __om_int_to_string(__v); }
inline string to_string(unsigned long long __v) { return __om_int_to_string(__v); }
// Only the whole part: nothing observable depends on the digits of a printed float here.
inline string to_string(double __v) { return __om_int_to_string((long long)__v); }
