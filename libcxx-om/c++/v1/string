// Operational Model: <string>
// Minimal std::string for verification

#ifndef _LIBCXX_OM_STRING
#define _LIBCXX_OM_STRING

namespace std {

class string {
public:
    typedef char value_type;
    typedef char* iterator;
    typedef const char* const_iterator;
    typedef unsigned long size_type;
    typedef long difference_type;
    typedef char& reference;
    typedef const char& const_reference;
    static constexpr size_type npos = (size_type)-1;

    string() : data_(new char[1]), size_(0), capacity_(1) { data_[0] = '\0'; }

    explicit string(size_type n, char c) : data_(new char[n + 1]), size_(n), capacity_(n + 1) {
        for (size_type i = 0; i < n; i++) data_[i] = c;
        data_[n] = '\0';
    }

    string(const char* s) : data_(nullptr), size_(0), capacity_(0) {
        size_type len = 0;
        while (s[len]) len++;
        data_ = new char[len + 1];
        size_ = len;
        capacity_ = len + 1;
        for (size_type i = 0; i <= len; i++) data_[i] = s[i];
    }

    string(const string& other) : data_(new char[other.capacity_]), size_(other.size_), capacity_(other.capacity_) {
        for (size_type i = 0; i < capacity_; i++) data_[i] = other.data_[i];
    }

    string(string&& other) noexcept : data_(other.data_), size_(other.size_), capacity_(other.capacity_) {
        other.data_ = nullptr;
        other.size_ = 0;
        other.capacity_ = 0;
    }

    ~string() { if (data_) delete[] data_; }

    string& operator=(const string& other) {
        if (this != &other) {
            if (data_) delete[] data_;
            data_ = new char[other.capacity_];
            size_ = other.size_;
            capacity_ = other.capacity_;
            for (size_type i = 0; i < capacity_; i++) data_[i] = other.data_[i];
        }
        return *this;
    }

    string& operator=(string&& other) noexcept {
        if (this != &other) {
            if (data_) delete[] data_;
            data_ = other.data_;
            size_ = other.size_;
            capacity_ = other.capacity_;
            other.data_ = nullptr;
            other.size_ = 0;
            other.capacity_ = 0;
        }
        return *this;
    }

    string& operator+=(const string& other) {
        append(other);
        return *this;
    }

    string& operator+=(char c) {
        push_back(c);
        return *this;
    }

    // Iterators
    iterator begin() { return data_; }
    const_iterator begin() const { return data_; }
    iterator end() { return data_ + size_; }
    const_iterator end() const { return data_ + size_; }
    const_iterator cbegin() const { return data_; }
    const_iterator cend() const { return data_ + size_; }

    // Capacity
    size_type size() const { return size_; }
    size_type length() const { return size_; }
    size_type max_size() const { return 1048576; }
    size_type capacity() const { return capacity_; }
    bool empty() const { return size_ == 0; }

    void reserve(size_type n) {
        if (n > capacity_) {
            char* nd = new char[n + 1];
            for (size_type i = 0; i <= size_; i++) nd[i] = data_[i];
            delete[] data_;
            data_ = nd;
            capacity_ = n;
        }
    }

    // Element access
    reference operator[](size_type n) { return data_[n]; }
    const_reference operator[](size_type n) const { return data_[n]; }
    reference at(size_type n) { if (n >= size_) __builtin_unreachable(); return data_[n]; }
    const_reference at(size_type n) const { if (n >= size_) __builtin_unreachable(); return data_[n]; }
    reference front() { return data_[0]; }
    const_reference front() const { return data_[0]; }
    reference back() { return data_[size_ - 1]; }
    const_reference back() const { return data_[size_ - 1]; }
    const char* c_str() const { return data_; }
    const char* data() const { return data_; }

    // Modifiers
    void clear() { size_ = 0; data_[0] = '\0'; }

    void push_back(char c) {
        if (size_ + 1 >= capacity_) {
            size_type nc = capacity_ == 0 ? 1 : capacity_ * 2;
            reserve(nc);
        }
        data_[size_++] = c;
        data_[size_] = '\0';
    }

    void append(const string& str) {
        if (size_ + str.size_ >= capacity_)
            reserve(size_ + str.size_);
        for (size_type i = 0; i < str.size_; i++)
            data_[size_++] = str.data_[i];
        data_[size_] = '\0';
    }

    void append(size_type n, char c) {
        if (size_ + n >= capacity_)
            reserve(size_ + n);
        for (size_type i = 0; i < n; i++)
            data_[size_++] = c;
        data_[size_] = '\0';
    }

    void resize(size_type n) { resize(n, '\0'); }
    void resize(size_type n, char c) {
        if (n > capacity_) reserve(n);
        while (size_ < n) { data_[size_++] = c; }
        data_[size_] = '\0';
    }

    void swap(string& other) {
        char* td = data_; size_type ts = size_; size_type tc = capacity_;
        data_ = other.data_; size_ = other.size_; capacity_ = other.capacity_;
        other.data_ = td; other.size_ = ts; other.capacity_ = tc;
    }

    // String operations
    int compare(const string& other) const {
        size_type minlen = (size_ < other.size_) ? size_ : other.size_;
        for (size_type i = 0; i < minlen; i++) {
            if (data_[i] < other.data_[i]) return -1;
            if (data_[i] > other.data_[i]) return 1;
        }
        if (size_ < other.size_) return -1;
        if (size_ > other.size_) return 1;
        return 0;
    }

    bool operator==(const string& other) const { return compare(other) == 0; }
    bool operator!=(const string& other) const { return compare(other) != 0; }
    bool operator<(const string& other) const { return compare(other) < 0; }
    bool operator>(const string& other) const { return compare(other) > 0; }
    bool operator<=(const string& other) const { return compare(other) <= 0; }
    bool operator>=(const string& other) const { return compare(other) >= 0; }

    size_type find(const string& str, size_type pos = 0) const {
        if (str.size_ == 0) return 0;
        for (size_type i = pos; i <= size_ - str.size_; i++) {
            bool found = true;
            for (size_type j = 0; j < str.size_; j++) {
                if (data_[i + j] != str.data_[j]) { found = false; break; }
            }
            if (found) return i;
        }
        return (size_type)-1;
    }

    size_type find(char c, size_type pos = 0) const {
        for (size_type i = pos; i < size_; i++) {
            if (data_[i] == c) return i;
        }
        return (size_type)-1;
    }

    string substr(size_type pos, size_type n = (size_type)-1) const {
        if (pos > size_) pos = size_;
        if (n > size_ - pos) n = size_ - pos;
        string s;
        s.reserve(n);
        for (size_type i = 0; i < n; i++) s.data_[s.size_++] = data_[pos + i];
        s.data_[s.size_] = '\0';
        return s;
    }

    void replace(size_type pos, size_type n, const string& str) {
        // simplified: just copy
    }

private:
    char* data_;
    size_type size_;
    size_type capacity_;
};

// Non-member swap
inline void swap(string& x, string& y) { x.swap(y); }

// String concatenation
inline string operator+(const string& x, const string& y) {
    string result = x;
    result.append(y);
    return result;
}

inline string operator+(const string& x, const char* y) {
    string result = x;
    string s(y);
    result.append(s);
    return result;
}

inline string operator+(const char* x, const string& y) {
    string result(x);
    result.append(y);
    return result;
}

} // namespace std

#endif // _LIBCXX_OM_STRING
