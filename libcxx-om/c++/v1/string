// Operational Model: <string>
// Simplified C++ header for std::string

#ifndef _LIBCXX_OM_STRING
#define _LIBCXX_OM_STRING

#include <stddef.h>

namespace std {

// string - simplified string class
class string {
public:
    typedef char value_type;
    typedef char* pointer;
    typedef const char* const_pointer;
    typedef char& reference;
    typedef const char& const_reference;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;

    typedef char* iterator;
    typedef const char* const_iterator;

    static constexpr size_type npos = static_cast<size_type>(-1);

    // Constructors
    string() : data_(new char[1]), size_(0), capacity_(1) {
        data_[0] = '\0';
    }

    string(const char* s) : data_(nullptr), size_(0), capacity_(0) {
        if (s) {
            size_ = 0;
            while (s[size_]) size_++;
            capacity_ = size_ + 1;
            data_ = new char[capacity_];
            for (size_type i = 0; i < size_; i++) {
                data_[i] = s[i];
            }
            data_[size_] = '\0';
        } else {
            data_ = new char[1];
            data_[0] = '\0';
        }
    }

    string(size_type n, char c) : data_(nullptr), size_(n), capacity_(n + 1) {
        data_ = new char[capacity_];
        for (size_type i = 0; i < size_; i++) {
            data_[i] = c;
        }
        data_[size_] = '\0';
    }

    string(const string& other) : data_(nullptr), size_(other.size_), capacity_(other.size_ + 1) {
        data_ = new char[capacity_];
        for (size_type i = 0; i < size_; i++) {
            data_[i] = other.data_[i];
        }
        data_[size_] = '\0';
    }

    string(string&& other) noexcept : data_(other.data_), size_(other.size_), capacity_(other.capacity_) {
        other.data_ = nullptr;
        other.size_ = 0;
        other.capacity_ = 0;
    }

    string(initializer_list<char> il) : data_(nullptr), size_(0), capacity_(0) {
        capacity_ = il.size() + 1;
        data_ = new char[capacity_];
        for (auto it = il.begin(); it != il.end(); ++it) {
            data_[size_] = *it;
            size_++;
        }
        data_[size_] = '\0';
    }

    ~string() {
        if (data_) {
            delete[] data_;
        }
    }

    // Assignment
    string& operator=(const string& other) {
        if (this != &other) {
            if (data_) delete[] data_;
            size_ = other.size_;
            capacity_ = other.size_ + 1;
            data_ = new char[capacity_];
            for (size_type i = 0; i < size_; i++) {
                data_[i] = other.data_[i];
            }
            data_[size_] = '\0';
        }
        return *this;
    }

    string& operator=(string&& other) noexcept {
        if (this != &other) {
            if (data_) delete[] data_;
            data_ = other.data_;
            size_ = other.size_;
            capacity_ = other.capacity_;
            other.data_ = nullptr;
            other.size_ = 0;
            other.capacity_ = 0;
        }
        return *this;
    }

    string& operator=(const char* s) {
        if (data_) delete[] data_;
        size_ = 0;
        if (s) {
            while (s[size_]) size_++;
        }
        capacity_ = size_ + 1;
        data_ = new char[capacity_];
        for (size_type i = 0; i < size_; i++) {
            data_[i] = s[i];
        }
        data_[size_] = '\0';
        return *this;
    }

    string& operator=(char c) {
        if (data_) delete[] data_;
        size_ = 1;
        capacity_ = 2;
        data_ = new char[2];
        data_[0] = c;
        data_[1] = '\0';
        return *this;
    }

    // Iterators
    iterator begin() noexcept { return data_; }
    const_iterator begin() const noexcept { return data_; }
    iterator end() noexcept { return data_ + size_; }
    const_iterator end() const noexcept { return data_ + size_; }
    const_iterator cbegin() const noexcept { return data_; }
    const_iterator cend() const noexcept { return data_ + size_; }

    // Capacity
    size_type size() const noexcept { return size_; }
    size_type length() const noexcept { return size_; }
    size_type max_size() const noexcept { return SIZE_MAX / sizeof(char); }
    size_type capacity() const noexcept { return capacity_; }
    bool empty() const noexcept { return size_ == 0; }

    void reserve(size_type n) {
        if (n > capacity_) {
            char* new_data = new char[n + 1];
            for (size_type i = 0; i < size_; i++) {
                new_data[i] = data_[i];
            }
            new_data[size_] = '\0';
            delete[] data_;
            data_ = new_data;
            capacity_ = n;
        }
    }

    void shrink_to_fit() noexcept {
        if (capacity_ > size_) {
            char* new_data = new char[size_ + 1];
            for (size_type i = 0; i < size_; i++) {
                new_data[i] = data_[i];
            }
            new_data[size_] = '\0';
            delete[] data_;
            data_ = new_data;
            capacity_ = size_;
        }
    }

    // Element access
    reference operator[](size_type n) noexcept { return data_[n]; }
    const_reference operator[](size_type n) const noexcept { return data_[n]; }

    reference at(size_type n) {
        if (n >= size_) {
            __VERIFIER_error();
        }
        return data_[n];
    }

    const_reference at(size_type n) const {
        if (n >= size_) {
            __VERIFIER_error();
        }
        return data_[n];
    }

    reference front() noexcept { return data_[0]; }
    const_reference front() const noexcept { return data_[0]; }
    reference back() noexcept { return data_[size_ - 1]; }
    const_reference back() const noexcept { return data_[size_ - 1]; }

    const_pointer data() const noexcept { return data_; }
    const char* c_str() const noexcept { return data_; }

    // Modifiers
    void clear() noexcept {
        size_ = 0;
        if (data_) data_[0] = '\0';
    }

    void push_back(char c) {
        if (size_ + 1 >= capacity_) {
            size_type new_cap = capacity_ == 0 ? 1 : capacity_ * 2;
            reserve(new_cap);
        }
        data_[size_] = c;
        size_++;
        data_[size_] = '\0';
    }

    void pop_back() {
        if (size_ > 0) {
            size_--;
            data_[size_] = '\0';
        }
    }

    string& operator+=(const string& other) {
        append(other);
        return *this;
    }

    string& operator+=(const char* s) {
        append(s);
        return *this;
    }

    string& operator+=(char c) {
        push_back(c);
        return *this;
    }

    string& append(const string& other) {
        if (other.size_ > 0) {
            size_type new_size = size_ + other.size_;
            if (new_size >= capacity_) {
                reserve(new_size + 1);
            }
            for (size_type i = 0; i < other.size_; i++) {
                data_[size_ + i] = other.data_[i];
            }
            size_ = new_size;
            data_[size_] = '\0';
        }
        return *this;
    }

    string& append(const char* s) {
        if (s) {
            size_type len = 0;
            while (s[len]) len++;
            if (len > 0) {
                size_type new_size = size_ + len;
                if (new_size >= capacity_) {
                    reserve(new_size + 1);
                }
                for (size_type i = 0; i < len; i++) {
                    data_[size_ + i] = s[i];
                }
                size_ = new_size;
                data_[size_] = '\0';
            }
        }
        return *this;
    }

    string& assign(const string& other) {
        if (this != &other) {
            if (data_) delete[] data_;
            size_ = other.size_;
            capacity_ = other.size_ + 1;
            data_ = new char[capacity_];
            for (size_type i = 0; i < size_; i++) {
                data_[i] = other.data_[i];
            }
            data_[size_] = '\0';
        }
        return *this;
    }

    string& assign(const char* s) {
        if (data_) delete[] data_;
        size_ = 0;
        if (s) {
            while (s[size_]) size_++;
        }
        capacity_ = size_ + 1;
        data_ = new char[capacity_];
        for (size_type i = 0; i < size_; i++) {
            data_[i] = s[i];
        }
        data_[size_] = '\0';
        return *this;
    }

    string& assign(size_type n, char c) {
        if (data_) delete[] data_;
        size_ = n;
        capacity_ = n + 1;
        data_ = new char[capacity_];
        for (size_type i = 0; i < size_; i++) {
            data_[i] = c;
        }
        data_[size_] = '\0';
        return *this;
    }

    string substr(size_type pos, size_type len = npos) const {
        if (pos >= size_) pos = size_;
        if (len == npos || pos + len > size_) len = size_ - pos;
        string result;
        result.size_ = len;
        result.capacity_ = len + 1;
        result.data_ = new char[len + 1];
        for (size_type i = 0; i < len; i++) {
            result.data_[i] = data_[pos + i];
        }
        result.data_[len] = '\0';
        return result;
    }

    int compare(const string& other) const {
        size_type len = size_ < other.size_ ? size_ : other.size_;
        for (size_type i = 0; i < len; i++) {
            if (data_[i] < other.data_[i]) return -1;
            if (data_[i] > other.data_[i]) return 1;
        }
        if (size_ < other.size_) return -1;
        if (size_ > other.size_) return 1;
        return 0;
    }

    int compare(const char* s) const {
        size_type other_len = 0;
        while (s[other_len]) other_len++;
        size_type len = size_ < other_len ? size_ : other_len;
        for (size_type i = 0; i < len; i++) {
            if (data_[i] < s[i]) return -1;
            if (data_[i] > s[i]) return 1;
        }
        if (size_ < other_len) return -1;
        if (size_ > other_len) return 1;
        return 0;
    }

    size_type find(const string& str, size_type pos = 0) const {
        if (str.size_ == 0) return 0;
        for (size_type i = pos; i <= size_ - str.size_; i++) {
            bool found = true;
            for (size_type j = 0; j < str.size_; j++) {
                if (data_[i + j] != str.data_[j]) {
                    found = false;
                    break;
                }
            }
            if (found) return i;
        }
        return npos;
    }

    size_type find(const char* s, size_type pos = 0) const {
        size_type len = 0;
        while (s[len]) len++;
        if (len == 0) return 0;
        for (size_type i = pos; i <= size_ - len; i++) {
            bool found = true;
            for (size_type j = 0; j < len; j++) {
                if (data_[i + j] != s[j]) {
                    found = false;
                    break;
                }
            }
            if (found) return i;
        }
        return npos;
    }

    size_type find(char c, size_type pos = 0) const {
        for (size_type i = pos; i < size_; i++) {
            if (data_[i] == c) return i;
        }
        return npos;
    }

    size_type rfind(const string& str, size_type pos = npos) const {
        if (str.size_ == 0) return size_ < pos ? size_ : pos;
        if (pos >= size_) pos = size_ - 1;
        for (; pos >= str.size_ - 1; pos--) {
            bool found = true;
            for (size_type j = 0; j < str.size_; j++) {
                if (data_[pos - str.size_ + 1 + j] != str.data_[j]) {
                    found = false;
                    break;
                }
            }
            if (found) return pos - str.size_ + 1;
        }
        return npos;
    }

    size_type find_first_of(const string& str, size_type pos = 0) const {
        for (size_type i = pos; i < size_; i++) {
            for (size_type j = 0; j < str.size_; j++) {
                if (data_[i] == str.data_[j]) return i;
            }
        }
        return npos;
    }

    size_type find_last_of(const string& str, size_type pos = npos) const {
        if (pos >= size_) pos = size_ - 1;
        for (; ; pos--) {
            for (size_type j = 0; j < str.size_; j++) {
                if (data_[pos] == str.data_[j]) return pos;
            }
            if (pos == 0) break;
        }
        return npos;
    }

    size_type find_first_not_of(const string& str, size_type pos = 0) const {
        for (size_type i = pos; i < size_; i++) {
            bool found = false;
            for (size_type j = 0; j < str.size_; j++) {
                if (data_[i] == str.data_[j]) {
                    found = true;
                    break;
                }
            }
            if (!found) return i;
        }
        return npos;
    }

    void swap(string& other) noexcept {
        char* tmp_data = data_;
        size_type tmp_size = size_;
        size_type tmp_capacity = capacity_;
        data_ = other.data_;
        size_ = other.size_;
        capacity_ = other.capacity_;
        other.data_ = tmp_data;
        other.size_ = tmp_size;
        other.capacity_ = tmp_capacity;
    }

    // Insert
    string& insert(size_type pos, const string& str) {
        if (pos > size_) pos = size_;
        size_type new_size = size_ + str.size_;
        if (new_size >= capacity_) {
            reserve(new_size + 1);
        }
        for (size_type i = size_; i > pos; i--) {
            data_[i + str.size_] = data_[i - 1];
        }
        for (size_type i = 0; i < str.size_; i++) {
            data_[pos + i] = str.data_[i];
        }
        size_ = new_size;
        data_[size_] = '\0';
        return *this;
    }

    // Erase
    string& erase(size_type pos = 0, size_type len = npos) {
        if (pos >= size_) return *this;
        if (len == npos || pos + len > size_) len = size_ - pos;
        for (size_type i = pos + len; i < size_; i++) {
            data_[i - len] = data_[i];
        }
        size_ -= len;
        data_[size_] = '\0';
        return *this;
    }

    // Replace
    string& replace(size_type pos, size_type len, const string& str) {
        erase(pos, len);
        insert(pos, str);
        return *this;
    }

    // Conversion
    operator const char*() const noexcept { return data_; }

    // Comparison operators
    bool operator==(const string& other) const { return compare(other) == 0; }
    bool operator!=(const string& other) const { return compare(other) != 0; }
    bool operator<(const string& other) const { return compare(other) < 0; }
    bool operator>(const string& other) const { return compare(other) > 0; }
    bool operator<=(const string& other) const { return compare(other) <= 0; }
    bool operator>=(const string& other) const { return compare(other) >= 0; }

    bool operator==(const char* s) const { return compare(s) == 0; }
    bool operator!=(const char* s) const { return compare(s) != 0; }
    bool operator<(const char* s) const { return compare(s) < 0; }
    bool operator>(const char* s) const { return compare(s) > 0; }
    bool operator<=(const char* s) const { return compare(s) <= 0; }
    bool operator>=(const char* s) const { return compare(s) >= 0; }

    // Arithmetic operators
    string operator+(const string& other) const {
        string result(*this);
        result.append(other);
        return result;
    }

    string operator+(const char* s) const {
        string result(*this);
        result.append(s);
        return result;
    }

    string operator+(char c) const {
        string result(*this);
        result.push_back(c);
        return result;
    }

private:
    char* data_;
    size_type size_;
    size_type capacity_;
};

// Non-member swap
inline void swap(string& x, string& y) noexcept {
    x.swap(y);
}

// Non-member comparison operators
inline bool operator==(const char* s, const string& str) {
    return str == s;
}

inline bool operator!=(const char* s, const string& str) {
    return str != s;
}

inline bool operator<(const char* s, const string& str) {
    return str > s;
}

inline bool operator>(const char* s, const string& str) {
    return str < s;
}

inline bool operator<=(const char* s, const string& str) {
    return str >= s;
}

inline bool operator>=(const char* s, const string& str) {
    return str <= s;
}

// Non-member arithmetic operators
inline string operator+(const char* s, const string& str) {
    string result(s);
    result.append(str);
    return result;
}

inline string operator+(char c, const string& str) {
    string result(1, c);
    result.append(str);
    return result;
}

} // namespace std

#endif // _LIBCXX_OM_STRING
