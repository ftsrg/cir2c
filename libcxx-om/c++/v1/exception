// Operational Model: <exception>
// Simplified exception support for verification

#ifndef _LIBCXX_OM_EXCEPTION
#define _LIBCXX_OM_EXCEPTION

namespace std {

// Base exception class — provides what() for error messages
class exception {
public:
    exception() noexcept {}
    exception(const exception&) noexcept {}
    exception& operator=(const exception&) noexcept { return *this; }
    virtual ~exception() noexcept {}
    virtual const char* what() const noexcept { return "std::exception"; }
};

// terminate handler type
typedef void (*terminate_handler)();
inline terminate_handler set_terminate(terminate_handler) noexcept { return nullptr; }
inline void terminate() noexcept { __builtin_unreachable(); }

// unexpected handler type
typedef void (*unexpected_handler)();
inline unexpected_handler set_unexpected(unexpected_handler) noexcept { return nullptr; }
inline void unexpected() noexcept { __builtin_unreachable(); }

// nested_exception for exception chaining
class nested_exception {
public:
    nested_exception() noexcept {}
    virtual ~nested_exception() noexcept {}
};

// throw_with_nested — simplified for verification (no actual throwing)
inline void throw_with_nested(const exception& e) {
    (void)e;
}

// rethrow_if_nested — no-op for verification
template<typename E>
inline void rethrow_if_nested(const E& e) {
    (void)e;
}

} // namespace std

// Global throw operator — simplified for verification
// In verification context, exceptions are caught and handled by the verifier
#define throw(expr) ((void)0)

#endif // _LIBCXX_OM_EXCEPTION
