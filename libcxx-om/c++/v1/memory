// Operational Model: <memory>
// Minimal smart pointers for verification

#ifndef _LIBCXX_OM_MEMORY
#define _LIBCXX_OM_MEMORY

namespace std {

typedef decltype(nullptr) nullptr_t;

// Minimal allocator
template<typename T>
struct allocator {
    typedef T value_type;
    typedef T* pointer;
    typedef const T* const_pointer;
    typedef unsigned long size_type;
    allocator() noexcept {}
    template<typename U> allocator(const allocator<U>&) noexcept {}
    pointer allocate(size_type n) { return static_cast<T*>(__builtin_malloc(n * sizeof(T))); }
    void deallocate(T* p, size_type) { __builtin_free(p); }
};

// default_delete
template<typename T>
struct default_delete {
    void operator()(T* p) const { delete p; }
};

// unique_ptr
template<typename T, typename Deleter = default_delete<T>>
class unique_ptr {
public:
    typedef T element_type;
    typedef Deleter deleter_type;

    unique_ptr() noexcept : ptr_(nullptr) {}
    explicit unique_ptr(T* p) noexcept : ptr_(p) {}
    unique_ptr(nullptr_t) noexcept : ptr_(nullptr) {}

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    unique_ptr(unique_ptr&& other) noexcept : ptr_(other.ptr_) { other.ptr_ = nullptr; }
    unique_ptr& operator=(unique_ptr&& other) noexcept {
        if (this != &other) {
            delete ptr_;
            ptr_ = other.ptr_;
            other.ptr_ = nullptr;
        }
        return *this;
    }

    ~unique_ptr() { delete ptr_; }

    T& operator*() const { return *ptr_; }
    T* operator->() const { return ptr_; }
    T* get() const noexcept { return ptr_; }
    explicit operator bool() const noexcept { return ptr_ != nullptr; }

    T* release() noexcept { T* p = ptr_; ptr_ = nullptr; return p; }
    void reset(T* p = nullptr) { delete ptr_; ptr_ = p; }
    void swap(unique_ptr& other) noexcept {
        T* tmp = ptr_; ptr_ = other.ptr_; other.ptr_ = tmp;
    }

private:
    T* ptr_;
};

template<typename T, typename Deleter>
void swap(unique_ptr<T, Deleter>& x, unique_ptr<T, Deleter>& y) noexcept {
    x.swap(y);
}

template<typename T, typename D1, typename D2>
bool operator==(const unique_ptr<T, D1>& x, const unique_ptr<T, D2>& y) {
    return x.get() == y.get();
}

template<typename T, typename D>
bool operator==(const unique_ptr<T, D>& x, nullptr_t) {
    return x.get() == nullptr;
}

// shared_count (simplified)
struct shared_count {
    unsigned long count_;
    shared_count() : count_(1) {}
    shared_count(const shared_count& other) : count_(other.count_) { count_++; }
    void add_ref() { count_++; }
    unsigned long release() { return --count_; }
    unsigned long use_count() const { return count_; }
    ~shared_count() {}
};

// shared_ptr
template<typename T>
class shared_ptr {
public:
    typedef T element_type;

    shared_ptr() noexcept : ptr_(nullptr), count_(new shared_count()) {}
    explicit shared_ptr(T* p) : ptr_(p), count_(new shared_count()) {}
    shared_ptr(nullptr_t) noexcept : ptr_(nullptr), count_(new shared_count()) {}

    shared_ptr(const shared_ptr& other) : ptr_(other.ptr_), count_(other.count_) {
        if (count_) count_->add_ref();
    }
    shared_ptr& operator=(const shared_ptr& other) {
        if (this != &other) {
            if (count_ && count_->release() == 0) {
                delete ptr_;
                delete count_;
            }
            ptr_ = other.ptr_;
            count_ = other.count_;
            if (count_) count_->add_ref();
        }
        return *this;
    }

    shared_ptr(shared_ptr&& other) noexcept : ptr_(other.ptr_), count_(other.count_) {
        other.ptr_ = nullptr;
        other.count_ = nullptr;
    }
    shared_ptr& operator=(shared_ptr&& other) noexcept {
        if (this != &other) {
            if (count_ && count_->release() == 0) {
                delete ptr_;
                delete count_;
            }
            ptr_ = other.ptr_;
            count_ = other.count_;
            other.ptr_ = nullptr;
            other.count_ = nullptr;
        }
        return *this;
    }

    ~shared_ptr() {
        if (count_ && count_->release() == 0) {
            delete ptr_;
            delete count_;
        }
    }

    T& operator*() const { return *ptr_; }
    T* operator->() const { return ptr_; }
    T* get() const noexcept { return ptr_; }
    explicit operator bool() const noexcept { return ptr_ != nullptr; }
    unsigned long use_count() const { return count_ ? count_->use_count() : 0; }
    bool unique() const { return use_count() == 1; }

    void reset() {
        if (count_ && count_->release() == 0) {
            delete ptr_;
            delete count_;
        }
        ptr_ = nullptr;
        count_ = nullptr;
    }
    void reset(T* p) {
        if (count_ && count_->release() == 0) {
            delete ptr_;
            delete count_;
        }
        ptr_ = p;
        count_ = new shared_count();
    }
    void swap(shared_ptr& other) noexcept {
        T* tmp_p = ptr_; shared_count* tmp_c = count_;
        ptr_ = other.ptr_; count_ = other.count_;
        other.ptr_ = tmp_p; other.count_ = tmp_c;
    }

private:
    T* ptr_;
    shared_count* count_;
};

template<typename T>
void swap(shared_ptr<T>& x, shared_ptr<T>& y) noexcept {
    x.swap(y);
}

template<typename T, typename U>
bool operator==(const shared_ptr<T>& x, const shared_ptr<U>& y) {
    return x.get() == y.get();
}

template<typename T>
bool operator==(const shared_ptr<T>& x, nullptr_t) {
    return x.get() == nullptr;
}

// make_unique
template<typename T>
unique_ptr<T> make_unique() {
    return unique_ptr<T>(new T());
}

template<typename T, typename... Args>
unique_ptr<T> make_unique(Args&&... args) {
    return unique_ptr<T>(new T(args...));
}

// make_shared
template<typename T>
shared_ptr<T> make_shared() {
    return shared_ptr<T>(new T());
}

template<typename T, typename... Args>
shared_ptr<T> make_shared(Args&&... args) {
    return shared_ptr<T>(new T(args...));
}

} // namespace std

#endif // _LIBCXX_OM_MEMORY
