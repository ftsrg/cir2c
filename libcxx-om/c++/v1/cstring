// Operational Model: <cstring>
// Simplified C++ header for C string operations

#ifndef _LIBCXX_OM_CSTRING
#define _LIBCXX_OM_CSTRING

#include <stddef.h>

namespace std {

// Nondeterministic intrinsics for verification
inline int __VERIFIER_nondet_int() {
    int x;
    x = __builtin_nondet_int();
    return x;
}

inline void* __VERIFIER_nondet_ptr() {
    void* p;
    p = (void*)__builtin_nondet_ptr();
    return p;
}

// strlen - returns length of null-terminated string
inline size_t strlen(const char* s) {
    size_t len = 0;
    while (s[len] != '\0') {
        len++;
    }
    return len;
}

// strcpy - copies source to destination
inline char* strcpy(char* dest, const char* src) {
    char* d = dest;
    while (*src) {
        *d++ = *src++;
    }
    *d = '\0';
    return dest;
}

// strcat - concatenates source to destination
inline char* strcat(char* dest, const char* src) {
    char* d = dest;
    while (*d) d++;
    while (*src) {
        *d++ = *src++;
    }
    *d = '\0';
    return dest;
}

// strcmp - compares two strings
inline int strcmp(const char* s1, const char* s2) {
    while (*s1 && *s1 == *s2) {
        s1++;
        s2++;
    }
    return (unsigned char)*s1 - (unsigned char)*s2;
}

// strncmp - compares up to n characters
inline int strncmp(const char* s1, const char* s2, size_t n) {
    while (n && *s1 && *s1 == *s2) {
        s1++;
        s2++;
        n--;
    }
    if (n == 0) return 0;
    return (unsigned char)*s1 - (unsigned char)*s2;
}

// strncpy - copies up to n characters
inline char* strncpy(char* dest, const char* src, size_t n) {
    char* d = dest;
    size_t i;
    for (i = 0; i < n && *src; i++) {
        *d++ = *src++;
    }
    for (; i < n; i++) {
        *d++ = '\0';
    }
    return dest;
}

// memset - sets n bytes to value
inline void* memset(void* ptr, int value, size_t n) {
    unsigned char* p = (unsigned char*)ptr;
    for (size_t i = 0; i < n; i++) {
        p[i] = (unsigned char)value;
    }
    return ptr;
}

// memcpy - copies n bytes
inline void* memcpy(void* dest, const void* src, size_t n) {
    unsigned char* d = (unsigned char*)dest;
    const unsigned char* s = (const unsigned char*)src;
    for (size_t i = 0; i < n; i++) {
        d[i] = s[i];
    }
    return dest;
}

// memmove - copies n bytes with overlap handling
inline void* memmove(void* dest, const void* src, size_t n) {
    unsigned char* d = (unsigned char*)dest;
    const unsigned char* s = (const unsigned char*)src;
    if (s < d) {
        for (size_t i = n; i > 0; i--) {
            d[i-1] = s[i-1];
        }
    } else {
        for (size_t i = 0; i < n; i++) {
            d[i] = s[i];
        }
    }
    return dest;
}

// memcmp - compares n bytes
inline int memcmp(const void* s1, const void* s2, size_t n) {
    const unsigned char* p1 = (const unsigned char*)s1;
    const unsigned char* p2 = (const unsigned char*)s2;
    for (size_t i = 0; i < n; i++) {
        if (p1[i] != p2[i]) {
            return p1[i] - p2[i];
        }
    }
    return 0;
}

// memchr - finds first occurrence of value in n bytes
inline void* memchr(const void* ptr, int value, size_t n) {
    const unsigned char* p = (const unsigned char*)ptr;
    for (size_t i = 0; i < n; i++) {
        if (p[i] == (unsigned char)value) {
            return (void*)(p + i);
        }
    }
    return nullptr;
}

// strchr - finds first occurrence of character in string
inline char* strchr(const char* s, int c) {
    while (*s) {
        if (*s == (char)c) return (char*)s;
        s++;
    }
    if ((char)c == '\0') return (char*)s;
    return nullptr;
}

// strstr - finds first occurrence of substring
inline char* strstr(const char* haystack, const char* needle) {
    if (!*needle) return (char*)haystack;
    while (*haystack) {
        const char* h = haystack;
        const char* n = needle;
        while (*h && *n && *h == *n) {
            h++;
            n++;
        }
        if (!*n) return (char*)haystack;
        haystack++;
    }
    return nullptr;
}

} // namespace std

#endif // _LIBCXX_OM_CSTRING
