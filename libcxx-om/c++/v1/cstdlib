// Operational Model: <cstdlib>
// Simplified C++ header for standard library functions

#ifndef _LIBCXX_OM_CSTDLIB
#define _LIBCXX_OM_CSTDLIB

#include <stddef.h>

namespace std {

// Nondeterministic intrinsics for verification
inline int __VERIFIER_nondet_int() {
    int x;
    x = __builtin_nondet_int();
    return x;
}

inline long __VERIFIER_nondet_long() {
    long x;
    x = __builtin_nondet_long();
    return x;
}

// abs - absolute value
inline int abs(int x) {
    return x < 0 ? -x : x;
}

inline long abs(long x) {
    return x < 0 ? -x : x;
}

inline long long abs(long long x) {
    return x < 0 ? -x : x;
}

// labs - long absolute value
inline long labs(long x) {
    return x < 0 ? -x : x;
}

// llabs - long long absolute value
inline long long llabs(long long x) {
    return x < 0 ? -x : x;
}

// div - integer division with remainder
struct div_t {
    int quot;
    int rem;
};

struct ldiv_t {
    long quot;
    long rem;
};

struct lldiv_t {
    long long quot;
    long long rem;
};

inline div_t div(int numer, int denom) {
    div_t result;
    result.quot = numer / denom;
    result.rem = numer % denom;
    return result;
}

inline ldiv_t div(long numer, long denom) {
    ldiv_t result;
    result.quot = numer / denom;
    result.rem = numer % denom;
    return result;
}

inline lldiv_t div(long long numer, long long denom) {
    lldiv_t result;
    result.quot = numer / denom;
    result.rem = numer % denom;
    return result;
}

// rand - returns nondeterministic integer
inline int rand() {
    return __VERIFIER_nondet_int();
}

// srand - seed the random number generator (no-op in verification)
inline void srand(unsigned int seed) {
    // No-op for verification purposes
}

// malloc - allocate memory (nondeterministic pointer)
inline void* malloc(size_t size) {
    (void)size;
    return __VERIFIER_nondet_ptr();
}

// free - deallocate memory (no-op in verification)
inline void free(void* ptr) {
    (void)ptr;
    // No-op for verification purposes
}

// calloc - allocate zero-initialized memory
inline void* calloc(size_t count, size_t size) {
    (void)count;
    (void)size;
    return __VERIFIER_nondet_ptr();
}

// realloc - reallocate memory
inline void* realloc(void* ptr, size_t size) {
    (void)ptr;
