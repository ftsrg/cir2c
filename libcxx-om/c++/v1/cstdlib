    return nullptr;
}

// qsort - quicksort (simplified)
inline void qsort(void* base, size_t nmemb, size_t size,
                  int (*compar)(const void*, const void*)) {
    // Simplified bubble sort for verification
    unsigned char* arr = (unsigned char*)base;
    for (size_t i = 0; i < nmemb; i++) {
        for (size_t j = 0; j < nmemb - 1; j++) {
            if (compar(arr + j * size, arr + (j + 1) * size) > 0) {
                // Swap
                unsigned char* tmp = (unsigned char*)malloc(size);
                for (size_t k = 0; k < size; k++) {
                    tmp[k] = arr[j * size + k];
                    arr[j * size + k] = arr[(j + 1) * size + k];
                    arr[(j + 1) * size + k] = tmp[k];
                }
                free(tmp);
            }
        }
    }
}

// bsearch - binary search
inline void* bsearch(const void* key, const void* base, size_t nmemb,
                     size_t size, int (*compar)(const void*, const void*)) {
    const unsigned char* b = (const unsigned char*)base;
    size_t low = 0, high = nmemb;
    while (low < high) {
        size_t mid = low + (high - low) / 2;
        int c = compar(key, b + mid * size);
        if (c < 0) {
            high = mid;
        } else if (c > 0) {
            low = mid + 1;
        } else {
            return (void*)(b + mid * size);
        }
    }
    return nullptr;
}

} // namespace std

#endif // _LIBCXX_OM_CSTDLIB
