// std::deque as a growable ring of pointers to single elements: indexing is one array
// access and elements stay where they are, as the standard requires of push and pop.
#ifndef _LIBCPP_DEQUE
#define _LIBCPP_DEQUE

#include <__config>
#include <__fwd/deque.h>
#include <__iterator/iterator_traits.h>
#include <__iterator/reverse_iterator.h>
#include <__type_traits/is_allocator.h>
#include <__memory/allocator.h>
#include <__type_traits/conditional.h>
#include <__type_traits/enable_if.h>
#include <__type_traits/is_integral.h>
#include <__utility/forward.h>
#include <__utility/move.h>
#include <algorithm>
#include <cstddef>
#include <initializer_list>
#include <iterator>
#include <new>
#include <stdexcept>
#include <cstdlib>

_LIBCPP_BEGIN_NAMESPACE_STD

template <class _Dq, class _Tp, bool _Const>
class __om_deque_iterator {
  using _Owner = __conditional_t<_Const, const _Dq*, _Dq*>;
  _Owner __d_;
  size_t __i_;

public:
  using iterator_category = random_access_iterator_tag;
  using value_type        = _Tp;
  using difference_type   = ptrdiff_t;
  using pointer           = __conditional_t<_Const, const _Tp*, _Tp*>;
  using reference         = __conditional_t<_Const, const _Tp&, _Tp&>;

  __om_deque_iterator() : __d_(nullptr), __i_(0) {}
  __om_deque_iterator(_Owner __d, size_t __i) : __d_(__d), __i_(__i) {}
  template <bool _C = _Const, __enable_if_t<_C, int> = 0>
  __om_deque_iterator(const __om_deque_iterator<_Dq, _Tp, false>& __o) : __d_(__o.__owner()), __i_(__o.__index()) {}
  _Owner __owner() const { return __d_; }
  size_t __index() const { return __i_; }
  reference operator*() const { return (*__d_)[__i_]; }
  pointer operator->() const { return &(*__d_)[__i_]; }
  reference operator[](difference_type __n) const { return (*__d_)[__i_ + __n]; }
  __om_deque_iterator& operator++() { ++__i_; return *this; }
  __om_deque_iterator operator++(int) { __om_deque_iterator __t = *this; ++__i_; return __t; }
  __om_deque_iterator& operator--() { --__i_; return *this; }
  __om_deque_iterator operator--(int) { __om_deque_iterator __t = *this; --__i_; return __t; }
  __om_deque_iterator& operator+=(difference_type __n) { __i_ += __n; return *this; }
  __om_deque_iterator& operator-=(difference_type __n) { __i_ -= __n; return *this; }
  friend __om_deque_iterator operator+(__om_deque_iterator __a, difference_type __n) { __a += __n; return __a; }
  friend __om_deque_iterator operator+(difference_type __n, __om_deque_iterator __a) { __a += __n; return __a; }
  friend __om_deque_iterator operator-(__om_deque_iterator __a, difference_type __n) { __a -= __n; return __a; }
  friend difference_type operator-(const __om_deque_iterator& __a, const __om_deque_iterator& __b) { return difference_type(__a.__i_) - difference_type(__b.__i_); }
  friend bool operator==(const __om_deque_iterator& __a, const __om_deque_iterator& __b) { return __a.__i_ == __b.__i_; }
  friend bool operator!=(const __om_deque_iterator& __a, const __om_deque_iterator& __b) { return __a.__i_ != __b.__i_; }
  friend bool operator<(const __om_deque_iterator& __a, const __om_deque_iterator& __b) { return __a.__i_ < __b.__i_; }
  friend bool operator>(const __om_deque_iterator& __a, const __om_deque_iterator& __b) { return __a.__i_ > __b.__i_; }
  friend bool operator<=(const __om_deque_iterator& __a, const __om_deque_iterator& __b) { return __a.__i_ <= __b.__i_; }
  friend bool operator>=(const __om_deque_iterator& __a, const __om_deque_iterator& __b) { return __a.__i_ >= __b.__i_; }
};

template <class _Tp, class _Allocator>
class deque {
  _Tp** __ring_;
  size_t __cap_;
  size_t __head_;
  size_t __size_;

  _Tp*& __slot(size_t __i) const { return __ring_[(__head_ + __i) % __cap_]; }
  void __make_room() {
    if (__size_ < __cap_) return;
    size_t __cap = __cap_ == 0 ? 8 : 2 * __cap_;
    _Tp** __r = static_cast<_Tp**>(malloc(__cap * sizeof(_Tp*)));
    if (__r == nullptr) abort();
    for (size_t __i = 0; __i < __size_; ++__i) __r[__i] = __slot(__i);
    free(__ring_);
    __ring_ = __r;
    __cap_ = __cap;
    __head_ = 0;
  }
  template <class... _Args>
  static _Tp* __make(_Args&&... __a) {
    void* __p = malloc(sizeof(_Tp));
    if (__p == nullptr) abort();
    return new (__p) _Tp(std::forward<_Args>(__a)...);
  }
  static void __drop(_Tp* __p) {
    __p->~_Tp();
    free(__p);
  }

public:
  using value_type             = _Tp;
  using allocator_type         = _Allocator;
  using size_type              = size_t;
  using difference_type        = ptrdiff_t;
  using reference              = _Tp&;
  using const_reference        = const _Tp&;
  using pointer                = _Tp*;
  using const_pointer          = const _Tp*;
  using iterator               = __om_deque_iterator<deque, _Tp, false>;
  using const_iterator         = __om_deque_iterator<deque, _Tp, true>;
  using reverse_iterator       = std::reverse_iterator<iterator>;
  using const_reverse_iterator = std::reverse_iterator<const_iterator>;

  deque() : __ring_(nullptr), __cap_(0), __head_(0), __size_(0) {}
  explicit deque(const _Allocator&) : deque() {}
  explicit deque(size_t __n) : deque() { for (size_t __i = 0; __i < __n; ++__i) emplace_back(); }
  deque(size_t __n, const _Tp& __v) : deque() { for (size_t __i = 0; __i < __n; ++__i) push_back(__v); }
  template <class _It, __enable_if_t<!is_integral<_It>::value, int> = 0>
  deque(_It __f, _It __l) : deque() { for (; __f != __l; ++__f) push_back(*__f); }
  deque(initializer_list<_Tp> __il) : deque(__il.begin(), __il.end()) {}
  deque(const deque& __o) : deque(__o.begin(), __o.end()) {}
  deque(deque&& __o) noexcept : __ring_(__o.__ring_), __cap_(__o.__cap_), __head_(__o.__head_), __size_(__o.__size_) {
    __o.__ring_ = nullptr;
    __o.__cap_ = __o.__head_ = __o.__size_ = 0;
  }
  ~deque() { clear(); free(__ring_); }
  deque& operator=(const deque& __o) {
    if (this != &__o) { clear(); for (const _Tp& __v : __o) push_back(__v); }
    return *this;
  }
  deque& operator=(deque&& __o) noexcept {
    if (this != &__o) { deque __t(std::move(__o)); swap(__t); }
    return *this;
  }
  allocator_type get_allocator() const { return allocator_type(); }
  reference operator[](size_t __i) { return *__slot(__i); }
  const_reference operator[](size_t __i) const { return *__slot(__i); }
  reference at(size_t __i) { if (__i >= __size_) std::__throw_out_of_range("deque"); return *__slot(__i); }
  const_reference at(size_t __i) const { if (__i >= __size_) std::__throw_out_of_range("deque"); return *__slot(__i); }
  reference front() { return *__slot(0); }
  const_reference front() const { return *__slot(0); }
  reference back() { return *__slot(__size_ - 1); }
  const_reference back() const { return *__slot(__size_ - 1); }
  iterator begin() { return iterator(this, 0); }
  const_iterator begin() const { return const_iterator(this, 0); }
  const_iterator cbegin() const { return begin(); }
  iterator end() { return iterator(this, __size_); }
  const_iterator end() const { return const_iterator(this, __size_); }
  const_iterator cend() const { return end(); }
  reverse_iterator rbegin() { return reverse_iterator(end()); }
  const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
  reverse_iterator rend() { return reverse_iterator(begin()); }
  const_reverse_iterator rend() const { return const_reverse_iterator(begin()); }
  bool empty() const { return __size_ == 0; }
  size_t size() const { return __size_; }
  size_t max_size() const { return size_t(-1) / sizeof(_Tp*); }
  void shrink_to_fit() {}
  void clear() { while (__size_ != 0) pop_back(); }
  template <class... _Args>
  reference emplace_back(_Args&&... __a) {
    _Tp* __p = __make(std::forward<_Args>(__a)...);
    __make_room();
    ++__size_;
    __slot(__size_ - 1) = __p;
    return *__p;
  }
  template <class... _Args>
  reference emplace_front(_Args&&... __a) {
    _Tp* __p = __make(std::forward<_Args>(__a)...);
    __make_room();
    __head_ = (__head_ + __cap_ - 1) % __cap_;
    ++__size_;
    __slot(0) = __p;
    return *__p;
  }
  void push_back(const _Tp& __v) { emplace_back(__v); }
  void push_back(_Tp&& __v) { emplace_back(std::move(__v)); }
  void push_front(const _Tp& __v) { emplace_front(__v); }
  void push_front(_Tp&& __v) { emplace_front(std::move(__v)); }
  void pop_back() { __drop(__slot(__size_ - 1)); --__size_; }
  void pop_front() { __drop(__slot(0)); __head_ = (__head_ + 1) % __cap_; --__size_; }
  iterator erase(const_iterator __pos) {
    size_t __i = __pos.__index();
    __drop(__slot(__i));
    for (size_t __k = __i; __k + 1 < __size_; ++__k) __slot(__k) = __slot(__k + 1);
    --__size_;
    return iterator(this, __i);
  }
  iterator erase(const_iterator __f, const_iterator __l) {
    size_t __i = __f.__index();
    for (size_t __n = __l.__index() - __i; __n != 0; --__n) erase(const_iterator(this, __i));
    return iterator(this, __i);
  }
  template <class... _Args>
  iterator emplace(const_iterator __pos, _Args&&... __a) {
    size_t __i = __pos.__index();
    emplace_back(std::forward<_Args>(__a)...);
    _Tp* __p = __slot(__size_ - 1);
    for (size_t __k = __size_ - 1; __k > __i; --__k) __slot(__k) = __slot(__k - 1);
    __slot(__i) = __p;
    return iterator(this, __i);
  }
  iterator insert(const_iterator __pos, const _Tp& __v) { return emplace(__pos, __v); }
  iterator insert(const_iterator __pos, _Tp&& __v) { return emplace(__pos, std::move(__v)); }
  void resize(size_t __n) {
    while (__size_ > __n) pop_back();
    while (__size_ < __n) emplace_back();
  }
  void swap(deque& __o) noexcept {
    _Tp** __r = __ring_; __ring_ = __o.__ring_; __o.__ring_ = __r;
    size_t __t = __cap_; __cap_ = __o.__cap_; __o.__cap_ = __t;
    __t = __head_; __head_ = __o.__head_; __o.__head_ = __t;
    __t = __size_; __size_ = __o.__size_; __o.__size_ = __t;
  }
};

template <class _Tp, class _A>
bool operator==(const deque<_Tp, _A>& __a, const deque<_Tp, _A>& __b) {
  return __a.size() == __b.size() && std::equal(__a.begin(), __a.end(), __b.begin());
}
template <class _Tp, class _A>
bool operator!=(const deque<_Tp, _A>& __a, const deque<_Tp, _A>& __b) { return !(__a == __b); }

_LIBCPP_END_NAMESPACE_STD

#endif
