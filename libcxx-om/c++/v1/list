// Operational Model: <list>
// Simplified C++ header for std::list

#ifndef _LIBCXX_OM_LIST
#define _LIBCXX_OM_LIST

#include <stddef.h>

namespace std {

template<typename T, typename Allocator = allocator<T>>
class list {
public:
    typedef T value_type;
    typedef Allocator allocator_type;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;

    struct iterator {
        T* ptr;
        iterator(T* p = nullptr) : ptr(p) {}
        T& operator*() const { return *ptr; }
        T* operator->() const { return ptr; }
        iterator& operator++() { ptr++; return *this; }
        iterator& operator--() { ptr--; return *this; }
        bool operator==(const iterator& other) const { return ptr == other.ptr; }
        bool operator!=(const iterator& other) const { return ptr != other.ptr; }
    };

    static constexpr size_t MAX_SIZE = 64;

    list() : data_(nullptr), size_(0) {}

    explicit list(size_type n) : data_(nullptr), size_(0) { resize(n); }
    list(size_type n, const T& value) : data_(nullptr), size_(0) { resize(n, value); }

    list(const list& other) : data_(nullptr), size_(0) {
        for (size_type i = 0; i < other.size_; i++) {
            push_back(other.data_[i]);
        }
    }

    list(list&& other) noexcept : data_(other.data_), size_(other.size_) {
        other.data_ = nullptr;
        other.size_ = 0;
    }

    ~list() {
        if (data_) delete[] data_;
    }

    list& operator=(const list& other) {
        if (this != &other) {
            clear();
            for (size_type i = 0; i < other.size_; i++) {
                push_back(other.data_[i]);
            }
        }
        return *this;
    }

    list& operator=(list&& other) noexcept {
        if (this != &other) {
            if (data_) delete[] data_;
            data_ = other.data_;
            size_ = other.size_;
            other.data_ = nullptr;
            other.size_ = 0;
        }
        return *this;
    }

    iterator begin() noexcept { return iterator(data_); }
    iterator end() noexcept { return iterator(data_ + size_); }
    const_iterator begin() const noexcept { return const_iterator(data_); }
    const_iterator end() const noexcept { return const_iterator(data_ + size_); }

    size_type size() const noexcept { return size_; }
    size_type max_size() const noexcept { return MAX_SIZE; }
    bool empty() const noexcept { return size_ == 0; }

    T& front() noexcept { return data_[0]; }
    const T& front() const noexcept { return data_[0]; }
    T& back() noexcept { return data_[size_ - 1]; }
    const T& back() const noexcept { return data_[size_ - 1]; }

    void push_front(const T& value) {
        if (size_ < MAX_SIZE) {
            T* new_data = new T[size_ + 1];
            new_data[0] = value;
            if (data_) {
                for (size_type i = 0; i < size_; i++) new_data[i + 1] = data_[i];
                delete[] data_;
            }
            data_ = new_data;
            size_++;
        }
    }

    void push_back(const T& value) {
        if (size_ < MAX_SIZE) {
            T* new_data = new T[size_ + 1];
            if (data_) {
                for (size_type i = 0; i < size_; i++) new_data[i] = data_[i];
                delete[] data_;
            }
            new_data[size_] = value;
            data_ = new_data;
            size_++;
        }
    }

    void pop_front() {
        if (size_ > 0) {
            T* new_data = new T[size_ - 1];
            for (size_type i = 0; i < size_ - 1; i++) new_data[i] = data_[i + 1];
            delete[] data_;
            data_ = new_data;
            size_--;
        }
    }

    void pop_back() {
        if (size_ > 0) {
            size_--;
        }
    }

    iterator insert(iterator pos, const T& value) {
        size_type idx = pos.ptr - data_;
        if (size_ < MAX_SIZE) {
            T* new_data = new T[size_ + 1];
            for (size_type i = 0; i < idx; i++) new_data[i] = data_[i];
            new_data[idx] = value;
            for (size_type i = idx; i < size_; i++) new_data[i + 1] = data_[i];
            delete[] data_;
            data_ = new_data;
            size_++;
            return iterator(data_ + idx);
        }
        return end();
    }

    iterator erase(iterator pos) {
        size_type idx = pos.ptr - data_;
        for (size_type i = idx; i < size_ - 1; i++) {
            data_[i] = data_[i + 1];
        }
        size_--;
        return iterator(data_ + idx);
    }

    void clear() noexcept {
        if (data_) delete[] data_;
        data_ = nullptr;
        size_ = 0;
    }

    void swap(list& other) noexcept {
        T* tmp_data = data_;
        size_type tmp_size = size_;
        data_ = other.data_;
        size_ = other.size_;
        other.data_ = tmp_data;
        other.size_ = tmp_size;
    }

    void resize(size_type n) { resize(n, T()); }

    void resize(size_type n, const T& value) {
        if (n < size_) {
            size_ = n;
        } else if (n > size_) {
            T* new_data = new T[n];
            if (data_) {
                for (size_type i = 0; i < size_; i++) new_data[i] = data_[i];
                delete[] data_;
            }
            for (size_type i = size_; i < n; i++) new_data[i] = value;
            data_ = new_data;
            size_ = n;
        }
    }

    void splice(iterator pos, list& other) {
        for (auto it = other.begin(); it != other.end(); ++it) {
            insert(pos, *it);
            ++pos;
        }
        other.clear();
    }

    void remove(const T& value) {
        for (auto it = begin(); it != end(); ) {
            if (*it == value) it = erase(it);
            else ++it;
        }
    }

    void unique() {
        if (size_ <= 1) return;
        size_type j = 0;
        for (size_type i = 1; i < size_; i++) {
            if (data_[i] != data_[j]) {
                data_[++j] = data_[i];
            }
        }
        size_ = j + 1;
    }

    void merge(list& other) {
        T* merged = new T[size_ + other.size_];
        size_type i = 0, j = 0, k = 0;
        while (i < size_ && j < other.size_) {
            if (other.data_[j] < data_[i]) {
                merged[k++] = other.data_[j++];
            } else {
                merged[k++] = data_[i++];
            }
        }
        while (i < size_) merged[k++] = data_[i++];
        while (j < other.size_) merged[k++] = other.data_[j++];
        if (data_) delete[] data_;
        data_ = merged;
        size_ = k;
        other.data_ = nullptr;
        other.size_ = 0;
    }

    void sort() {
        for (size_type i = 0; i < size_; i++) {
            for (size_type j = i + 1; j < size_; j++) {
                if (data_[j] < data_[i]) {
                    T tmp = data_[i];
                    data_[i] = data_[j];
                    data_[j] = tmp;
                }
            }
        }
    }

    void reverse() {
        for (size_type i = 0; i < size_ / 2; i++) {
            T tmp = data_[i];
            data_[i] = data_[size_ - 1 - i];
            data_[size_ - 1 - i] = tmp;
        }
    }

    bool operator==(const list& other) const {
        if (size_ != other.size_) return false;
        for (size_type i = 0; i < size_; i++) {
            if (data_[i] != other.data_[i]) return false;
        }
        return true;
    }

    bool operator!=(const list& other) const { return !(*this == other); }

private:
    T* data_;
    size_type size_;
};

template<typename T, typename Allocator>
void swap(list<T, Allocator>& x, list<T, Allocator>& y) noexcept {
    x.swap(y);
}

} // namespace std

#endif // _LIBCXX_OM_LIST
