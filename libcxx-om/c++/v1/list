// std::list on the shared node list.
#ifndef _LIBCPP_LIST
#define _LIBCPP_LIST

#include <__config>
#include <__memory/allocator.h>
#include <__om/node_list.h>
#include <__type_traits/enable_if.h>
#include <__type_traits/is_integral.h>
#include <__functional/operations.h>
#include <algorithm>
#include <initializer_list>
#include <iterator>

_LIBCPP_BEGIN_NAMESPACE_STD

template <class _Tp, class _Allocator = allocator<_Tp> >
class list : public __om_node_list<_Tp> {
  using _Base = __om_node_list<_Tp>;

public:
  using value_type      = _Tp;
  using allocator_type  = _Allocator;
  using size_type       = size_t;
  using difference_type = ptrdiff_t;
  using reference       = _Tp&;
  using const_reference = const _Tp&;
  using pointer         = _Tp*;
  using const_pointer   = const _Tp*;
  using typename _Base::const_iterator;
  using typename _Base::const_reverse_iterator;
  using typename _Base::iterator;
  using typename _Base::reverse_iterator;

  list() {}
  explicit list(const _Allocator&) {}
  explicit list(size_t __n) { for (size_t __i = 0; __i < __n; ++__i) emplace_back(); }
  list(size_t __n, const _Tp& __v) { for (size_t __i = 0; __i < __n; ++__i) push_back(__v); }
  template <class _It, __enable_if_t<!is_integral<_It>::value, int> = 0>
  list(_It __first, _It __last) { for (; __first != __last; ++__first) push_back(*__first); }
  list(initializer_list<_Tp> __il) : list(__il.begin(), __il.end()) {}
  list(const list& __o) : list(__o.begin(), __o.end()) {}
  list(list&& __o) noexcept { this->__take(__o); }
  list& operator=(const list& __o) {
    if (this != &__o) { this->clear(); for (const _Tp& __v : __o) push_back(__v); }
    return *this;
  }
  list& operator=(list&& __o) noexcept {
    if (this != &__o) { this->clear(); this->__take(__o); }
    return *this;
  }
  allocator_type get_allocator() const { return allocator_type(); }

  reference front() { return *this->begin(); }
  const_reference front() const { return *this->begin(); }
  reference back() { return *--this->end(); }
  const_reference back() const { return *--this->end(); }
  void push_back(const _Tp& __v) { this->__emplace_before(this->end(), __v); }
  void push_back(_Tp&& __v) { this->__emplace_before(this->end(), std::move(__v)); }
  void push_front(const _Tp& __v) { this->__emplace_before(this->begin(), __v); }
  void push_front(_Tp&& __v) { this->__emplace_before(this->begin(), std::move(__v)); }
  template <class... _Args>
  reference emplace_back(_Args&&... __a) { return *this->__emplace_before(this->end(), std::forward<_Args>(__a)...); }
  template <class... _Args>
  reference emplace_front(_Args&&... __a) { return *this->__emplace_before(this->begin(), std::forward<_Args>(__a)...); }
  template <class... _Args>
  iterator emplace(const_iterator __p, _Args&&... __a) { return this->__emplace_before(__p, std::forward<_Args>(__a)...); }
  void pop_back() { this->erase(--this->end()); }
  void pop_front() { this->erase(this->begin()); }
  iterator insert(const_iterator __p, const _Tp& __v) { return this->__emplace_before(__p, __v); }
  iterator insert(const_iterator __p, _Tp&& __v) { return this->__emplace_before(__p, std::move(__v)); }
  void remove(const _Tp& __v) {
    for (iterator __i = this->begin(); __i != this->end();)
      if (*__i == __v) __i = this->erase(__i); else ++__i;
  }
  template <class _Pred>
  void remove_if(_Pred __p) {
    for (iterator __i = this->begin(); __i != this->end();)
      if (__p(*__i)) __i = this->erase(__i); else ++__i;
  }
  void resize(size_t __n) {
    while (this->size() > __n) pop_back();
    while (this->size() < __n) emplace_back();
  }
  void swap(list& __o) noexcept { list __t(std::move(__o)); __o = std::move(*this); *this = std::move(__t); }
  void splice(const_iterator __pos, list& __o) { splice(__pos, __o, __o.begin(), __o.end()); }
  void splice(const_iterator __pos, list&& __o) { splice(__pos, __o, __o.begin(), __o.end()); }
  void splice(const_iterator __pos, list& __o, const_iterator __i) {
    const_iterator __l = __i;
    splice(__pos, __o, __i, ++__l);
  }
  void splice(const_iterator __pos, list& __o, const_iterator __f, const_iterator __l) {
    while (__f != __l) {
      const_iterator __next = __f;
      ++__next;
      __om_link* __n = __f.__link();
      __o.__unlink(__n);
      this->__link_before(__pos.__link(), __n);
      __f = __next;
    }
  }
};

template <class _Tp, class _A>
bool operator==(const list<_Tp, _A>& __a, const list<_Tp, _A>& __b) {
  return __a.size() == __b.size() && std::equal(__a.begin(), __a.end(), __b.begin());
}
template <class _Tp, class _A>
bool operator!=(const list<_Tp, _A>& __a, const list<_Tp, _A>& __b) { return !(__a == __b); }

_LIBCPP_END_NAMESPACE_STD

#endif
