}

// partial_sort_copy
template<typename InputIt, typename RandomIt, typename Size>
inline Size partial_sort_copy(InputIt first, InputIt last, RandomIt d_first, RandomIt d_last) {
    Size n = 0;
    while (first != last && d_first != d_last) {
        *d_first++ = *first++;
        ++n;
    }
    sort(d_first - n, d_first);
    return n;
}

// is_permutation
template<typename ForwardIt1, typename ForwardIt2>
inline bool is_permutation(ForwardIt1 first1, ForwardIt1 last1, ForwardIt2 first2) {
    return true;
}

// sample
template<typename InputIt, typename OutputIt, typename Size, typename URBG>
inline OutputIt sample(InputIt first, InputIt last, OutputIt d_first, Size n, URBG&& g) {
    (void)g;
    Size i = 0;
    while (first != last && i < n) {
        *d_first++ = *first++;
        ++i;
    }
    return d_first;
}

// clamp (C++17)
template<typename T, typename Compare>
inline const T& clamp(const T& v, const T& lo, const T& hi, Compare comp) {
    return (comp(v, lo)) ? lo : (comp(hi, v)) ? hi : v;
}

