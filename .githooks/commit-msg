# Enforces this repository's one-rule commit convention locally, so a bad
# message is caught at commit time rather than by CI. Enable with:
#
#   git config core.hooksPath .githooks
#
# See the "Contribute" section of README.md.

set -euo pipefail

msg_file="$1"

# Drop comment lines (git's own template) and trailing blank lines.
body=$(grep -v '^#' "$msg_file" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
lines=$(printf '%s\n' "$body" | wc -l)

fail=0

if [ "$lines" -gt 1 ]; then
    echo "commit-msg: this repository uses a single subject line — no body." >&2
    fail=1
fi

if printf '%s\n' "$body" | grep -qiE '^\s*(co-authored-by|claude-session|generated-by)\s*:'; then
    echo "commit-msg: trailers are not used in this repository." >&2
    fail=1
fi

if printf '%s\n' "$body" | grep -qiE 'claude|copilot|chatgpt|generated with'; then
    echo "commit-msg: commit messages do not carry AI attribution." >&2
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo >&2
    echo "See the \"Contribute\" section of README.md. Your message was left in $msg_file." >&2
    exit 1
fi
