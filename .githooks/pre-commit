set -euo pipefail

ident="$(git var GIT_AUTHOR_IDENT) $(git var GIT_COMMITTER_IDENT)"

if printf '%s' "$ident" | grep -qiE 'anthropic\.com|noreply@openai|copilot@'; then
    cat >&2 <<MSG
pre-commit: this commit would be attributed to an AI identity:
  $(git var GIT_AUTHOR_IDENT)

Commits here are attributed to the person responsible for the change. Set your
identity for this clone:

  git config user.name "Your Name"
  git config user.email you@example.com

See CONTRIBUTING.md.
MSG
    exit 1
fi
